# Neo4j Configuration
NEO4J_URI=neo4j+s://demo.neo4jlabs.com
NEO4J_USERNAME=
NEO4J_PASSWORD=
NEO4J_DATABASE=
T2C_PROFILE_DATABASE=


# OpenAI Configuration
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# Text-to-Cypher profile configuration
T2C_PROFILE_DIR=generated_profiles
T2C_API_EXECUTION_ROW_CAP=100
T2C_RUNTIME_PROPERTY_SAMPLE_LIMIT=2000
T2C_SCHEMA_GROUNDING_MODE=profile
T2C_ENTITY_RESOLVER_ENABLED=true
T2C_ENTITY_RESOLVER_MAX_TOKENS=8
T2C_ENTITY_RESOLVER_MAX_HITS=8

# App Configuration
FREE_QUESTIONS_PER_SESSION=100
FLASK_PORT=8954
FLASK_HOST=0.0.0.0
SERVER_URL=http://localhost

# Analytics (optional)
SEGMENT_WRITE_KEY=
