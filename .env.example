# Neo4j Labs demo datasets:
# movies, northwind, recommendations, twitter, stackoverflow
NEO4J_URI=neo4j+s://demo.neo4jlabs.com
NEO4J_USERNAME=
NEO4J_PASSWORD=
NEO4J_DATABASE=
T2C_PROFILE_DATABASE=

# CypherBench datasets are separate Neo4j instances on exxacta100 and require
# a Temple SSH tunnel. Local forwarded ports:
#   company=15062, fictional_character=15063,
#   flight_accident=15064, geography=15065
# After opening the tunnel, use this shape (do not commit real credentials):
# NEO4J_URI=bolt://localhost:15062
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=<cypherbench-password>
# NEO4J_DATABASE=neo4j
# T2C_PROFILE_DATABASE=company


# OpenAI Configuration
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
OPENAI_REQUEST_TIMEOUT=30

# Local OpenAI-compatible model
LOCAL_LLM_BASE_URL=http://localhost:20128/v1
LOCAL_LLM_API_KEY=local
LOCAL_LLM_MODEL=antigravity/gemini-2.5-flash
LOCAL_LLM_REQUEST_TIMEOUT=120

# false: OpenAI -> local fallback; true: local -> OpenAI fallback
LLM_LOCAL_FIRST=false
LLM_FALLBACK_ENABLED=true
# Keep provider retries at zero so 429/timeout switches provider immediately.
LLM_PROVIDER_MAX_RETRIES=0

# Text-to-Cypher profile configuration
T2C_PROFILE_DIR=generated_profiles
T2C_API_EXECUTION_ROW_CAP=100
T2C_RUNTIME_PROPERTY_SAMPLE_LIMIT=2000
T2C_SCHEMA_GROUNDING_MODE=profile
T2C_ENTITY_RESOLVER_ENABLED=true
T2C_ENTITY_RESOLVER_MAX_TOKENS=8
T2C_ENTITY_RESOLVER_MAX_HITS=8
T2C_PROFILE_FIRST=false
T2C_GENERATE_ONLY=false
T2C_ADD_ORDER_NOT_NULL_GUARDS=false
T2C_CYPHER_RETRIES=2
T2C_DIRECT_FALLBACK_ENABLED=true

# Benchmark fast mode recommendation:
# T2C_GENERATE_ONLY=true              # T2C executor runs generated Cypher once.
# T2C_CYPHER_RETRIES=0                # One Cypher LLM call per request.
# T2C_DIRECT_FALLBACK_ENABLED=false   # Avoid an extra fallback LLM call.

# Debugging. Full tracing may contain prompts and sampled data.
PIPELINE_TRACE=false
PIPELINE_TRACE_MAX_CHARS=30000

# Batch trace tool defaults
TRACE_SAMPLE_DBS=movies,northwind,recommendations,twitter
TRACE_SAMPLE_LIMIT=10

# App Configuration
FLASK_PORT=8954
FLASK_HOST=0.0.0.0
API_LOG_LEVEL=ERROR
SERVER_URL=http://localhost

# Analytics (optional)
